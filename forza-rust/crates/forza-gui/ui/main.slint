// Images vertical slice (Fase 4): inventory list, filters, selection,
// detail pane, and a status/error line.

import { ComboBox, Button, ListView } from "std-widgets.slint";

export struct ImageItem {
    id: string,
    name: string,
    processing: string,
    best-lap: string,
    file-status: string,
}

export component MainWindow inherits Window {
    title: "Forza Motorsport Results Extractor";
    min-width: 860px;
    min-height: 520px;
    preferred-width: 1100px;
    preferred-height: 680px;
    background: #1e1f22;

    callback refresh-requested(string /* processing filter */);
    callback selection-changed(int /* row index */);

    in property <[ImageItem]> images;
    in property <string> status-text;
    in property <string> detail-title;
    in property <string> detail-lines;

    in-out property <string> filter-value: "all";
    in-out property <int> selected-index: -1;

    HorizontalLayout {
        padding: 10px;
        spacing: 8px;

        // Filters column
        VerticalLayout {
            spacing: 6px;
            width: 210px;
            Text {
                text: "Filters";
                color: #d0d0d0;
                font-size: 13px;
                font-weight: 700;
            }
            ComboBox {
                model: ["all", "unprocessed", "processing", "processed_ok",
                        "processed_error", "cancelled", "skipped"];
                current-index: 0;
                selected => {
                    root.filter-value = self.current-value;
                    root.refresh-requested(self.current-value);
                }
            }
            Rectangle { vertical-stretch: 1; }
            Button {
                text: "Refresh";
                clicked => { root.refresh-requested(root.filter-value); }
            }
        }

        // List + details
        VerticalLayout {
            spacing: 6px;
            HorizontalLayout {
                height: 26px;
                Text {
                    text: "Images";
                    color: #d0d0d0;
                    font-weight: 700;
                    vertical-alignment: center;
                }
                Rectangle {}
                Text {
                    text: root.status-text;
                    color: #9aa4b2;
                    vertical-alignment: center;
                }
            }
            HorizontalLayout {
                spacing: 8px;
                vertical-stretch: 1;

                Rectangle {
                    background: #26282c;
                    border-radius: 6px;
                    clip: true;

                    lv := ListView {
                        x: 4px;
                        y: 4px;
                        width: parent.width - 8px;
                        height: parent.height - 8px;

                        for item[index] in root.images: TouchArea {
                            height: 30px;
                            width: lv.width;
                            clicked => {
                                root.selected-index = index;
                                root.selection-changed(index);
                            }
                            Rectangle {
                                x: 1px;
                                y: 1px;
                                width: parent.width - 2px;
                                height: parent.height - 2px;
                                border-radius: 4px;
                                background: root.selected-index == index ? #3a4048 : transparent;
                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    Text {
                                        text: item.name;
                                        color: #e6e6e6;
                                        horizontal-stretch: 2;
                                        overflow: elide;
                                        vertical-alignment: center;
                                    }
                                    Text {
                                        text: item.processing;
                                        color: item.processing == "processed_ok" ? #7bd88f :
                                               item.processing == "processed_error" ? #ef6b6b :
                                               item.processing == "processing" ? #ffd166 : #9aa4b2;
                                        width: 128px;
                                        vertical-alignment: center;
                                    }
                                    Text {
                                        text: item.best-lap;
                                        color: #9aa4b2;
                                        width: 118px;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }
                }

                // Detail pane
                VerticalLayout {
                    width: 270px;
                    spacing: 6px;
                    Text {
                        text: root.detail-title;
                        color: #d0d0d0;
                        font-weight: 700;
                    }
                    Rectangle {
                        background: #26282c;
                        border-radius: 6px;
                        vertical-stretch: 1;
                        Text {
                            x: 10px;
                            y: 8px;
                            width: parent.width - 20px;
                            text: root.detail-lines;
                            color: #cfd6dd;
                            wrap: word-wrap;
                            font-size: 12px;
                        }
                    }
                }
            }
        }
    }
}
