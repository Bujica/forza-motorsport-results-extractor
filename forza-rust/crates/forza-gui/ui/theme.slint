// Global design system: single source of truth for palette, typography and
// spacing. Light theme — all text-on-card combinations must keep at least
// WCAG-AA-ish contrast (the pre-theme layout mixed dark-theme leftovers on
// white cards and was unreadable).

export global Theme {
    // ── Surfaces ──
    out property <color> bg: #f3f6fa;            // window background (Python APP_BG)
    out property <color> card: #ffffff;          // content card (Python SURFACE)
    out property <color> card-alt: #f8f9fa;      // alternating rows (Python SURFACE_ALT)
    out property <color> header-bg: #eaecf0;     // table header strip
    out property <color> border: #d0d7de;        // hairline borders (Python BORDER)
    out property <color> divider: #e4e8ee;
    out property <color> grid-line: #e7eaee;     // vertical column separators (Qt table grid)

    // ── Sidebar ──
    out property <color> sidebar-bg: #ffffff;
    out property <color> sidebar-text: #1f2328;
    out property <color> sidebar-muted: #57606a;
    out property <color> sidebar-active: #eaf4ff;

    // ── Text (dark on light surfaces) ──
    out property <color> text: #1f2328;          // primary (Python TEXT)
    out property <color> text-muted: #57606a;    // secondary (Python MUTED)
    out property <color> text-faint: #8a94a3;    // tertiary/hints
    out property <color> text-on-dark: #e8ecef;

    // ── Accents & status ──
    out property <color> accent: #0f6cbd;
    out property <color> accent-soft: #eaf4ff;   // (Python ACCENT_SOFT)
    out property <color> ok: #1d7a45;
    out property <color> ok-soft: #e2f5e9;
    out property <color> warn: #8a6116;
    out property <color> warn-soft: #fdf3d7;
    out property <color> danger: #b3261e;
    out property <color> danger-soft: #fde8e7;
    out property <color> progress: #4c8bf5;
    out property <color> selection-bg: #dbeafe;  // focused row on light cards
    out property <color> row-selected: #e8f1fb;  // multi-selected row tint

    // Best-laps semantic tints (Python parity)
    out property <color> row-mine: #fff4cc;
    out property <color> row-dirty: #fde8e7;
    out property <color> row-external: #ddeefa;

    // ── Typography ──
    // Scalable: base * ui-scale, clamped to min-font-px for QuadHD.
    // ui-scale is driven from [ui] font_scale (1.0 default, 1.25 QuadHD comfort)
    // and min-font-px from [ui] min_font_px (12 default).
    in-out property <float> ui-scale: 1.0;
    in-out property <int> ui-min-px: 13;
    out property <length> _base-xs: 10px;
    out property <length> _base-sm: 12px;
    out property <length> _base-md: 13px;
    out property <length> _min-px: 1px * root.ui-min-px;
    out property <length> font-xs: Math.max(root._min-px * 0.92, root._base-xs * root.ui-scale);
    out property <length> font-sm: Math.max(root._min-px, root._base-sm * root.ui-scale);
    out property <length> font-md: Math.max(root._min-px + 1px, root._base-md * root.ui-scale);
    out property <length> font-lg: Math.max(14px, 15px * root.ui-scale);
    out property <length> font-title: Math.max(16px, 18px * root.ui-scale);
    out property <length> font-xl: Math.max(15px, 17px * root.ui-scale);
    out property <length> log-font: Math.max(11px, 11px * root.ui-scale);

    // ── Spacing & metrics — scaled with ui-scale (F2)
    out property <length> radius: 12px;
    out property <length> row-h: Math.max(32px, 38px * root.ui-scale);
    out property <length> row-h-tall: Math.max(38px, 46px * root.ui-scale);
    out property <length> card-pad: Math.max(12px, 14px * root.ui-scale);
    out property <length> header-h: Math.max(22px, 26px * root.ui-scale);
    out property <length> control-h: Math.max(24px, 28px * root.ui-scale);
    out property <length> bar-h: Math.max(36px, 42px * root.ui-scale);
    out property <length> badge-h: Math.max(16px, 18px * root.ui-scale);
    out property <length> pad-sm: Math.max(6px, 8px * root.ui-scale);
    out property <length> pad-md: Math.max(10px, 12px * root.ui-scale);
    out property <length> splitter-w: Math.max(5px, 6px * root.ui-scale);
    out property <length> statusbar-h: Math.max(20px, 22px * root.ui-scale);

    // ── Class palette (F4) → Theme
    public pure function class-color(c: string) -> color {
        return c == "E" ? #C7368E : c == "D" ? #127F85 : c == "C" ? #BB7A00 : c == "B" ? #C54E00 : c == "A" ? #992800 : c == "TCR" ? #1E90FF : c == "S" ? #613BBF : c == "R" ? #105DAB : c == "P" ? #0C8540 : c == "X" ? #006000 : c == "Mixed" ? #555555 : #000000;
    }
    public pure function doctor-row-bg(result: string) -> color {
        return result == "FAIL" ? #fde8e7 : result == "WARN" ? #fdf3d7 : #e2f5e9;
    }
    public pure function doctor-row-fg(result: string) -> color {
        return result == "FAIL" ? #b3261e : result == "WARN" ? #8a6116 : #1d7a45;
    }
    public pure function doctor-badge-bg(level: string) -> color {
        return level == "FAIL" ? #481818 : level == "WARN" ? #4a3a12 : #183a24;
    }
    public pure function doctor-badge-fg(level: string) -> color {
        return level == "FAIL" ? #ffb4b4 : level == "WARN" ? #ffdf8a : #a8e8b0;
    }
}
