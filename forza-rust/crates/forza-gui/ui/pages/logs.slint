// Logs page: application log and errors log with search, clear, open folder.
// Parity with forza/gui/views/logs_view.py

import { Button, LineEdit, ListView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { Card, EmptyState } from "../components/common.slint";

export component LogsPage inherits Rectangle {
    background: transparent;

    in property <string> app-log-text;
    in property <string> error-log-text;
    in-out property <string> logs-tab;
    in-out property <string> logs-search;
    in property <string> logs-status;

    callback logs-reload-requested();
    callback logs-clear-requested(string);
    callback logs-open-folder();
    callback logs-search-changed(string);

    function filtered-text() -> string {
        if root.logs-search == "" {
            return root.logs-tab == "app" ? root.app-log-text : root.error-log-text;
        }
        // Client-side filter fallback is handled in Rust (filtered model); Slint just shows raw text for now.
        return root.logs-tab == "app" ? root.app-log-text : root.error-log-text;
    }

    VerticalLayout {
        spacing: 8px;

        HorizontalLayout {
            height: 32px;
            spacing: 8px;
            Text { text: "Technical Logs"; color: Theme.text; font-weight: 700; min-width: 110px; vertical-alignment: center; }
            Rectangle { horizontal-stretch: 1; }
            Button { text: "Reload"; clicked => { root.logs-reload-requested(); } }
            Button { text: "Clear tab"; clicked => { root.logs-clear-requested(root.logs-tab); } }
            Button { text: "Open log folder"; clicked => { root.logs-open-folder(); } }
        }

        HorizontalLayout {
            height: 28px;
            spacing: 6px;
            Text { text: "Search"; color: Theme.text-muted; font-size: Theme.font-sm; vertical-alignment: center; }
            LineEdit {
                placeholder-text: "Search in current tab…";
                text <=> root.logs-search;
                edited(text) => { root.logs-search-changed(text); }
                horizontal-stretch: 1;
            }
            Text { text: root.logs-status; color: Theme.text-muted; font-size: Theme.font-sm; vertical-alignment: center; min-width: 80px; overflow: elide; }
            Rectangle { horizontal-stretch: 0.2; }
        }

        HorizontalLayout {
            height: 30px;
            spacing: 4px;
            for tab in [
                { key: "app", label: "Application Log" },
                { key: "errors", label: "Errors" },
            ]: Rectangle {
                border-radius: 4px;
                background: root.logs-tab == tab.key ? Theme.accent : Theme.header-bg;
                min-width: 130px;
                TouchArea {
                    clicked => { root.logs-tab = tab.key; }
                    Text {
                        text: tab.label;
                        color: root.logs-tab == tab.key ? #ffffff : Theme.text-muted;
                        font-size: Theme.font-sm;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: parent.width;
                    }
                }
            }
            Rectangle { horizontal-stretch: 1; }
        }

        Card {
            vertical-stretch: 1;
            clip: true;
            // Log text area (last 200KB). Wrapped so full lines are readable;
            // the search box filters down long files. Font follows the
            // scalable Theme.log-font (was a fixed 10px that ignored ui-scale).
            Rectangle {
                clip: true;
                Text {
                    x: 10px; y: 8px;
                    width: parent.width - 20px;
                    text: root.filtered-text();
                    color: Theme.text-muted;
                    wrap: word-wrap;
                    font-size: Theme.log-font;
                }
            }
            if root.filtered-text() == "": EmptyState {
                text: "Log file is empty or missing.";
            }
        }
    }
}
