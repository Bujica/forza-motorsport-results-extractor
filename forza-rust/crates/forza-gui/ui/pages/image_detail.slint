// Image Detail pseudo-page: full preview plus laps/reviews/extractions/attempts.

import { Button, ListView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { DetailAttemptItem, DetailLapItem, DetailResultItem, DetailReviewItem } from "../models.slint";
import { Card, EmptyState, TableHeaderCell, TableCell, SplitterH, TabBar } from "../components/common.slint";

export component ImageDetailPage inherits Rectangle {
    background: transparent;

    in property <string> detail-title;
    in property <string> detail-badges;
    in property <string> detail-path;
    in property <string> detail-image-id;
    in property <string> detail-meta;
    in property <string> detail-tab;
    in property <bool> detail-loaded;
    in property <image> detail-preview;
    in property <bool> detail-has-preview;
    in property <[DetailLapItem]> detail-laps;
    in property <[DetailReviewItem]> detail-reviews;
    in property <[DetailResultItem]> detail-results;
    in property <[DetailAttemptItem]> detail-attempts;

    in-out property <length> preview-split: 460px;
    callback detail-tab-changed(string);
    callback detail-prev();
    callback detail-next();
    callback detail-close();
    callback open-image-debug(string);

    VerticalLayout {
        spacing: 8px;

        HorizontalLayout {
            height: 34px;
            spacing: 8px;
            Text {
                text: root.detail-title;
                color: Theme.text;
                font-weight: 800;
                font-size: Theme.font-xl;
                horizontal-stretch: 1;
                overflow: elide;
                vertical-alignment: center;
            }
            Text { text: root.detail-badges; color: Theme.ok; font-size: Theme.font-sm; vertical-alignment: center; }
        }

        HorizontalLayout {
            spacing: 0px;
            vertical-stretch: 1;

            // Preview card — resizable via vertical splitter (user request)
            VerticalLayout {
                width: root.preview-split;
                spacing: 6px;
                Text { text: "Preview"; color: Theme.text; font-weight: 700; }
                Card {
                    vertical-stretch: 1;
                    clip: true;
                    if root.detail-has-preview: Image {
                        width: parent.width;
                        height: parent.height;
                        source: root.detail-preview;
                        image-fit: contain;
                    }
                    if !root.detail-has-preview: Text {
                        width: parent.width;
                        y: parent.height / 2 - 10px;
                        text: "preview unavailable";
                        color: Theme.text-faint;
                        horizontal-alignment: center;
                    }
                }
                Text { text: root.detail-path; color: Theme.text-faint; font-size: Theme.font-xs; overflow: elide; }
            }

            SplitterH {
                split <=> root.preview-split;
                min-split: 260px;
                max-split: parent.width - 420px;
            }

            // Tabs + content
            VerticalLayout {
                spacing: 6px;
                horizontal-stretch: 1;

                TabBar {
                    tabs: [
                        { key: "metadata", label: "Metadata" },
                        { key: "laps", label: "Laps" },
                        { key: "reviews", label: "Review cases" },
                        { key: "extractions", label: "Extractions" },
                        { key: "attempts", label: "Attempts" },
                    ];
                    current: root.detail-tab;
                    tab-clicked(key) => { root.detail-tab-changed(key); }
                }

                Card {
                    vertical-stretch: 1;
                    clip: true;

                    // Metadata tab
                    if root.detail-tab == "metadata": Text {
                        x: 12px; y: 10px;
                        width: parent.width - 24px;
                        text: root.detail-meta;
                        color: Theme.text-muted;
                        wrap: word-wrap;
                        font-size: Theme.font-md;
                    }

                    // Laps tab — header + rows aligned (common.slint TableCell parity)
                    if root.detail-tab == "laps": VerticalLayout {
                        x: 4px; y: 4px;
                        width: parent.width - 8px;
                        height: parent.height - 8px;
                        spacing: 4px;
                        Rectangle {
                            height: 26px;
                            background: Theme.header-bg;
                            border-radius: 4px;
                            clip: true;
                            HorizontalLayout {
                                TableHeaderCell { label: "#"; width-pref: 36px; }
                                TableHeaderCell { label: "Track"; width-pref: 180px; }
                                TableHeaderCell { label: "Class"; width-pref: 70px; }
                                TableHeaderCell { label: "Driver"; width-pref: 140px; }
                                TableHeaderCell { label: "Car"; width-pref: 150px; }
                                TableHeaderCell { label: "Best Lap"; width-pref: 110px; }
                                TableHeaderCell { label: "Flags"; width-pref: 60px; flexible: true; resizable: true; }
                            }
                        }
                        dl := ListView {
                            vertical-stretch: 1;
                            for lap[index] in root.detail-laps: Rectangle {
                                height: 28px;
                                width: dl.width;
                                background: lap.best ? Theme.row-mine : (lap.dirty ? Theme.row-dirty : (Math.mod(index, 2) == 1 ? Theme.card-alt : transparent));
                                HorizontalLayout {
                                    TableCell { text: lap.index; width-pref: 36px; }
                                    TableCell { text: lap.track; width-pref: 180px; }
                                    TableCell { text: lap.class; width-pref: 70px; }
                                    TableCell { text: lap.driver; width-pref: 140px; text-color: lap.best ? Theme.warn : Theme.text-muted; }
                                    TableCell { text: lap.car; width-pref: 150px; }
                                    TableCell { text: lap.time; width-pref: 110px; text-color: lap.dirty ? Theme.danger : Theme.ok; }
                                    TableCell { text: lap.flags; width-pref: 60px; flexible: true; grid-line: false; }
                                }
                            }
                        }
                        if root.detail-laps.length == 0: EmptyState { text: "No lap records for this image."; }
                    }

                    // Review cases tab
                    if root.detail-tab == "reviews": VerticalLayout {
                        x: 4px; y: 4px;
                        width: parent.width - 8px;
                        height: parent.height - 8px;
                        spacing: 4px;
                        Rectangle {
                            height: 26px;
                            background: Theme.header-bg;
                            border-radius: 4px;
                            clip: true;
                            HorizontalLayout {
                                TableHeaderCell { label: "#"; width-pref: 48px; }
                                TableHeaderCell { label: "Reason"; width-pref: 105px; }
                                TableHeaderCell { label: "Driver"; width-pref: 140px; }
                                TableHeaderCell { label: "Track"; width-pref: 150px; }
                                TableHeaderCell { label: "Model"; width-pref: 150px; }
                                TableHeaderCell { label: "Status"; width-pref: 90px; flexible: true; resizable: true; }
                            }
                        }
                        drl := ListView {
                            vertical-stretch: 1;
                            for case in root.detail-reviews: Rectangle {
                                height: Theme.row-h;
                                width: drl.width;
                                HorizontalLayout {
                                    TableCell { text: "#" + case.number; width-pref: 48px; }
                                    TableCell { text: case.reason; width-pref: 105px; text-color: Theme.warn; }
                                    TableCell { text: case.driver; width-pref: 140px; }
                                    TableCell { text: case.track; width-pref: 150px; }
                                    TableCell { text: case.model-value; width-pref: 150px; }
                                    TableCell { text: case.status; width-pref: 90px; flexible: true; grid-line: false; }
                                }
                            }
                        }
                        if root.detail-reviews.length == 0: EmptyState { text: "No review cases for this image."; }
                    }

                    // Extractions tab
                    if root.detail-tab == "extractions": VerticalLayout {
                        x: 4px; y: 4px;
                        width: parent.width - 8px;
                        height: parent.height - 8px;
                        spacing: 4px;
                        Rectangle {
                            height: 26px;
                            background: Theme.header-bg;
                            border-radius: 4px;
                            clip: true;
                            HorizontalLayout {
                                TableHeaderCell { label: "Status"; width-pref: 80px; }
                                TableHeaderCell { label: "Run"; width-pref: 130px; }
                                TableHeaderCell { label: "Model"; width-pref: 150px; }
                                TableHeaderCell { label: "Attempts"; width-pref: 90px; }
                                TableHeaderCell { label: "Duration"; width-pref: 100px; }
                                TableHeaderCell { label: "Tokens"; width-pref: 110px; }
                                TableHeaderCell { label: "Created"; width-pref: 150px; flexible: true; }
                            }
                        }
                        derl := ListView {
                            vertical-stretch: 1;
                            for result in root.detail-results: Rectangle {
                                height: Theme.row-h;
                                width: derl.width;
                                HorizontalLayout {
                                    TableCell { text: result.status; width-pref: 80px; text-color: result.status == "ok" ? Theme.ok : Theme.danger; }
                                    TableCell { text: result.run; width-pref: 130px; }
                                    TableCell { text: result.model; width-pref: 150px; }
                                    TableCell { text: result.attempts + " attempt(s)"; width-pref: 90px; }
                                    TableCell { text: result.duration; width-pref: 100px; }
                                    TableCell { text: result.tokens; width-pref: 110px; }
                                    TableCell { text: result.created; width-pref: 150px; flexible: true; grid-line: false; }
                                }
                            }
                        }
                        if root.detail-results.length == 0: EmptyState { text: "No extraction results for this image."; }
                    }

                    // Attempts tab
                    if root.detail-tab == "attempts": VerticalLayout {
                        x: 4px; y: 4px;
                        width: parent.width - 8px;
                        height: parent.height - 8px;
                        spacing: 4px;
                        Rectangle {
                            height: 26px;
                            background: Theme.header-bg;
                            border-radius: 4px;
                            clip: true;
                            HorizontalLayout {
                                TableHeaderCell { label: "#"; width-pref: 30px; }
                                TableHeaderCell { label: "Reason"; width-pref: 90px; }
                                TableHeaderCell { label: "Status"; width-pref: 74px; }
                                TableHeaderCell { label: "Model"; width-pref: 130px; }
                                TableHeaderCell { label: "Rejected"; width-pref: 100px; }
                                TableHeaderCell { label: "Duration"; width-pref: 90px; }
                                TableHeaderCell { label: "TPS"; width-pref: 90px; }
                                TableHeaderCell { label: "Created"; width-pref: 150px; flexible: true; }
                            }
                        }
                        dal := ListView {
                            vertical-stretch: 1;
                            for attempt in root.detail-attempts: Rectangle {
                                height: Theme.row-h;
                                width: dal.width;
                                HorizontalLayout {
                                    TableCell { text: attempt.number; width-pref: 30px; }
                                    TableCell { text: attempt.reason; width-pref: 90px; text-color: Theme.warn; }
                                    TableCell { text: attempt.status; width-pref: 74px; text-color: attempt.accepted ? Theme.ok : Theme.danger; }
                                    TableCell { text: attempt.model; width-pref: 130px; }
                                    TableCell { text: attempt.rejected; width-pref: 100px; }
                                    TableCell { text: attempt.duration; width-pref: 90px; }
                                    TableCell { text: attempt.tps; width-pref: 90px; }
                                    TableCell { text: attempt.created; width-pref: 150px; flexible: true; grid-line: false; }
                                }
                            }
                        }
                        if root.detail-attempts.length == 0: EmptyState { text: "No attempts recorded."; }
                    }
                }
            }
        }

        HorizontalLayout {
            height: 34px;
            spacing: 8px;
            Button { text: "← Previous"; clicked => { root.detail-prev(); } }
            Button { text: "Next →"; clicked => { root.detail-next(); } }
            Button { text: "Open image debug"; enabled: root.detail-loaded; clicked => { root.open-image-debug(root.detail-image-id); } }
            Rectangle { horizontal-stretch: 1; }
            Button { text: "Close"; clicked => { root.detail-close(); } }
        }
    }
}
