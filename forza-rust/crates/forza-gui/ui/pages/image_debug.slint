// Image Debug page: 11-column case table + filter bar + 10 detail tabs.
// Parity with Python ImageDebugView (280px Image, fixed cols, 5-filter bar).

import { Button, ComboBox, ListView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { DebugCaseItem, DebugResultComboItem } from "../models.slint";
import { Card, EmptyState, TableHeaderCell, TableCell, SplitterV, TabBar } from "../components/common.slint";

export component ImageDebugPage inherits Rectangle {
    background: transparent;

    in property <[DebugCaseItem]> debug-cases;
    in property <[DebugResultComboItem]> debug-results;
    in property <[string]> debug-result-labels;
    // Mirrors the actually-loaded result id (Rust sets it on every detail
    // reload); without this the combo always displayed row 0 while the tabs
    // showed another result.
    in-out property <int> debug-result-index: 0;
    in property <string> debug-title;
    in property <string> debug-selected-image-id;
    in property <string> debug-selected-result-id;
    in-out property <string> debug-tab;
    in property <string> debug-overview-text;
    in property <string> debug-metadata-text;
    in property <string> debug-results-text;
    in property <string> debug-attempts-text;
    in property <string> debug-response-text;
    in property <string> debug-parsed-text;
    in property <string> debug-laps-reviews-text;
    in property <string> debug-artifacts-text;
    in property <string> debug-runtime-text;
    in property <string> debug-timeline-text;

    // Filter bar (Python: status/backend/model/prompt/run)
    in-out property <string> debug-status-filter: "all";
    in-out property <string> debug-backend-filter: "all";
    in-out property <string> debug-model-filter: "all";
    in-out property <string> debug-prompt-filter: "all";
    in-out property <string> debug-run-filter: "all";
    in property <[string]> debug-status-options: ["all", "ok", "error", "pending", "running", "cancelled"];
    in property <[string]> debug-backend-options: ["all"];
    in property <[string]> debug-model-options: ["all"];
    in property <[string]> debug-prompt-options: ["all"];
    in property <[string]> debug-run-options: ["all"];

    // Interactive column widths — fixed columns rebalanced so the 11-col
    // sum (~925px) fits the minimum window; Image is user-resizable.
    in-out property <length> col-image-w: 220px;
    in-out property <length> table-h: 300px;

    callback debug-refresh-requested();
    callback debug-filter-changed(string, string, string, string, string);
    callback debug-case-selected(int);
    callback debug-result-selected(string);
    callback debug-open-image-detail();

    function emit-filter() {
        root.debug-filter-changed(root.debug-status-filter, root.debug-backend-filter, root.debug-model-filter, root.debug-prompt-filter, root.debug-run-filter);
    }

    function tab-text(key: string) -> string {
        return key == "overview" ? root.debug-overview-text :
               key == "metadata" ? root.debug-metadata-text :
               key == "results" ? root.debug-results-text :
               key == "attempts" ? root.debug-attempts-text :
               key == "response" ? root.debug-response-text :
               key == "parsed" ? root.debug-parsed-text :
               key == "laps" ? root.debug-laps-reviews-text :
               key == "artifacts" ? root.debug-artifacts-text :
               key == "runtime" ? root.debug-runtime-text :
               root.debug-timeline-text;
    }

    VerticalLayout {
        spacing: 8px;

        HorizontalLayout {
            height: 32px;
            spacing: 8px;
            Text { text: "Image Debug"; color: Theme.text; font-weight: 700; min-width: 92px; vertical-alignment: center; }
            Button { text: "Refresh"; clicked => { root.debug-refresh-requested(); } }
            Text { text: root.debug-selected-image-id; color: Theme.text-faint; font-size: Theme.font-xs; overflow: elide; horizontal-stretch: 1; vertical-alignment: center; max-width: 340px; }
        }

        // Filter bar
        Card {
            HorizontalLayout {
                padding: 6px;
                spacing: 8px;
                height: 30px;
                Text { text: "Status"; color: Theme.text-muted; font-size: Theme.font-sm; vertical-alignment: center; }
                ComboBox { model: root.debug-status-options; current-value: root.debug-status-filter; min-width: 105px; selected(v) => { root.debug-status-filter = v; root.emit-filter(); } }
                Text { text: "Backend"; color: Theme.text-muted; font-size: Theme.font-sm; vertical-alignment: center; }
                ComboBox { model: root.debug-backend-options; current-value: root.debug-backend-filter; min-width: 105px; selected(v) => { root.debug-backend-filter = v; root.emit-filter(); } }
                Text { text: "Model"; color: Theme.text-muted; font-size: Theme.font-sm; vertical-alignment: center; }
                ComboBox { model: root.debug-model-options; current-value: root.debug-model-filter; min-width: 130px; selected(v) => { root.debug-model-filter = v; root.emit-filter(); } }
                Text { text: "Prompt"; color: Theme.text-muted; font-size: Theme.font-sm; vertical-alignment: center; }
                ComboBox { model: root.debug-prompt-options; current-value: root.debug-prompt-filter; min-width: 130px; selected(v) => { root.debug-prompt-filter = v; root.emit-filter(); } }
                Text { text: "Run"; color: Theme.text-muted; font-size: Theme.font-sm; vertical-alignment: center; }
                ComboBox { model: root.debug-run-options; current-value: root.debug-run-filter; min-width: 130px; selected(v) => { root.debug-run-filter = v; root.emit-filter(); } }
                Rectangle { horizontal-stretch: 1; }
            }
        }

        // Cases table — 11 columns (Python widths) with vertical splitter
        Card {
            height: root.table-h;
            clip: true;
            VerticalLayout {
                padding: 4px;
                spacing: 4px;
                // Header — Python Interactive(0) + Fixed(1-10)
                Rectangle {
                    height: 26px;
                    background: Theme.header-bg;
                    border-radius: 4px;
                    clip: true;
                    HorizontalLayout {
                        TableHeaderCell { label: "Image"; width-pref <=> root.col-image-w; resizable: true; }
                        TableHeaderCell { label: "Race Date"; width-pref: 90px; }
                        TableHeaderCell { label: "File"; width-pref: 85px; }
                        TableHeaderCell { label: "Process"; width-pref: 95px; }
                        TableHeaderCell { label: "Best"; width-pref: 90px; }
                        TableHeaderCell { label: "Latest"; width-pref: 90px; }
                        TableHeaderCell { label: "Run"; width-pref: 90px; }
                        TableHeaderCell { label: "Model"; width-pref: 85px; }
                        TableHeaderCell { label: "Att"; width-pref: 40px; }
                        TableHeaderCell { label: "Laps"; width-pref: 40px; }
                        TableHeaderCell { label: "Rev"; width-pref: 44px; flexible: true; resizable: true; }
                    }
                }
                dcv := ListView {
                    vertical-stretch: 1;
                    for item[index] in root.debug-cases: TouchArea {
                        height: 28px;
                        width: dcv.width;
                        clicked => { root.debug-case-selected(index); }
                        Rectangle {
                            x: 1px; y: 1px;
                            width: parent.width - 2px;
                            height: parent.height - 2px;
                            border-radius: 4px;
                            background: root.debug-selected-image-id == item.image-file-id ? Theme.selection-bg : transparent;
                            HorizontalLayout {
                                TableCell { text: item.image-name; width-pref: root.col-image-w; text-color: Theme.text; }
                                TableCell { text: item.race-date; width-pref: 90px; text-color: Theme.text-muted; }
                                TableCell { text: item.file-status; width-pref: 85px; text-color: Theme.text-muted; }
                                TableCell { text: item.processing; width-pref: 95px; text-color: item.processing == "processed_ok" ? Theme.ok : item.processing == "processed_error" ? Theme.danger : Theme.text-muted; }
                                TableCell { text: item.best-lap; width-pref: 90px; text-color: Theme.text-muted; }
                                TableCell { text: item.latest-status; width-pref: 90px; text-color: item.latest-status == "ok" ? Theme.ok : item.latest-status == "error" ? Theme.danger : Theme.text-muted; }
                                TableCell { text: item.run-id; width-pref: 90px; text-color: Theme.text-muted; }
                                TableCell { text: item.model; width-pref: 85px; text-color: Theme.text-muted; }
                                TableCell { text: item.attempts; width-pref: 40px; text-color: Theme.text-faint; }
                                TableCell { text: item.laps; width-pref: 40px; text-color: Theme.text-faint; }
                                TableCell { text: item.reviews; width-pref: 44px; flexible: true; text-color: Theme.text-faint; grid-line: false; }
                            }
                        }
                    }
                }
            }
            if root.debug-cases.length == 0: EmptyState {
                width: parent.width - 24px;
                text: "No debug cases. Refresh to load the latest extraction cases.";
            }
        }

        SplitterV {
            split <=> root.table-h;
            min-split: 150px;
            max-split: parent.height - 250px;
        }

        // Detail header
        HorizontalLayout {
            height: 32px;
            spacing: 8px;
            Text { text: root.debug-title; color: Theme.text; font-weight: 700; horizontal-stretch: 1; overflow: elide; vertical-alignment: center; }
            ComboBox {
                min-width: 220px;
                model: root.debug-result-labels;
                current-index <=> root.debug-result-index;
                selected(value) => {
                    if (self.current-index >= 0 && self.current-index < root.debug-results.length) {
                        root.debug-result-selected(root.debug-results[self.current-index].id);
                    }
                }
            }
            Button { text: "Image details"; clicked => { root.debug-open-image-detail(); } }
        }

        // Tabs — 10 tabs (Python parity) — shared TabBar component
        TabBar {
            tabs: [
                { key: "overview", label: "Overview" },
                { key: "metadata", label: "Metadata" },
                { key: "results", label: "Results" },
                { key: "attempts", label: "Attempts" },
                { key: "response", label: "Response" },
                { key: "parsed", label: "Parsed" },
                { key: "laps", label: "Laps & Reviews" },
                { key: "artifacts", label: "Artifacts" },
                { key: "runtime", label: "Runtime" },
                { key: "timeline", label: "Timeline" },
            ];
            current <=> root.debug-tab;
            tab-clicked(key) => { root.debug-tab = key; }
        }

        Card {
            vertical-stretch: 1;
            clip: true;
            Text {
                x: 10px; y: 8px;
                width: parent.width - 20px;
                height: parent.height - 16px;
                text: root.tab-text(root.debug-tab);
                color: Theme.text-muted;
                wrap: word-wrap;
                font-size: Theme.font-sm;
            }
        }
    }
}
