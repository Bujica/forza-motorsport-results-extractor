// Image Debug page: 11-column case table + filter bar + 10 detail tabs.
// Parity with Python ImageDebugView (280px Image, fixed cols, 5-filter bar).

import { Button, ComboBox, ListView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { DebugCaseItem, DebugResultComboItem } from "../models.slint";
import { Card, EmptyState } from "../components/common.slint";

export component ImageDebugPage inherits Rectangle {
    background: transparent;

    in property <[DebugCaseItem]> debug-cases;
    in property <[DebugResultComboItem]> debug-results;
    in property <[string]> debug-result-labels;
    in property <string> debug-title;
    in property <string> debug-selected-image-id;
    in property <string> debug-selected-result-id;
    in-out property <string> debug-tab;
    in property <string> debug-overview-text;
    in property <string> debug-metadata-text;
    in property <string> debug-results-text;
    in property <string> debug-attempts-text;
    in property <string> debug-response-text;
    in property <string> debug-parsed-text;
    in property <string> debug-laps-reviews-text;
    in property <string> debug-artifacts-text;
    in property <string> debug-runtime-text;
    in property <string> debug-timeline-text;

    // Filter bar (Python: status/backend/model/prompt/run)
    in-out property <string> debug-status-filter: "all";
    in-out property <string> debug-backend-filter: "all";
    in-out property <string> debug-model-filter: "all";
    in-out property <string> debug-prompt-filter: "all";
    in-out property <string> debug-run-filter: "all";
    in property <[string]> debug-status-options: ["all", "ok", "error", "pending", "running", "cancelled"];
    in property <[string]> debug-backend-options: ["all"];
    in property <[string]> debug-model-options: ["all"];
    in property <[string]> debug-prompt-options: ["all"];
    in property <[string]> debug-run-options: ["all"];

    callback debug-refresh-requested();
    callback debug-filter-changed(string, string, string, string, string);
    callback debug-case-selected(int);
    callback debug-result-selected(string);
    callback debug-open-image-detail();

    function emit-filter() {
        root.debug-filter-changed(root.debug-status-filter, root.debug-backend-filter, root.debug-model-filter, root.debug-prompt-filter, root.debug-run-filter);
    }

    function tab-text(key: string) -> string {
        return key == "overview" ? root.debug-overview-text :
               key == "metadata" ? root.debug-metadata-text :
               key == "results" ? root.debug-results-text :
               key == "attempts" ? root.debug-attempts-text :
               key == "response" ? root.debug-response-text :
               key == "parsed" ? root.debug-parsed-text :
               key == "laps" ? root.debug-laps-reviews-text :
               key == "artifacts" ? root.debug-artifacts-text :
               key == "runtime" ? root.debug-runtime-text :
               root.debug-timeline-text;
    }

    VerticalLayout {
        spacing: 8px;

        HorizontalLayout {
            height: 32px;
            spacing: 8px;
            Text { text: "Image Debug"; color: Theme.text; font-weight: 700; min-width: 92px; vertical-alignment: center; }
            Button { text: "Refresh"; clicked => { root.debug-refresh-requested(); } }
            Text { text: root.debug-selected-image-id; color: Theme.text-faint; font-size: Theme.font-xs; overflow: elide; horizontal-stretch: 1; vertical-alignment: center; }
        }

        // Filter bar
        Card {
            HorizontalLayout {
                padding: 6px;
                spacing: 8px;
                height: 30px;
                Text { text: "Status"; color: Theme.text-muted; font-size: Theme.font-sm; vertical-alignment: center; }
                ComboBox { model: root.debug-status-options; current-value: root.debug-status-filter; min-width: 90px; selected(v) => { root.debug-status-filter = v; root.emit-filter(); } }
                Text { text: "Backend"; color: Theme.text-muted; font-size: Theme.font-sm; vertical-alignment: center; }
                ComboBox { model: root.debug-backend-options; current-value: root.debug-backend-filter; min-width: 90px; selected(v) => { root.debug-backend-filter = v; root.emit-filter(); } }
                Text { text: "Model"; color: Theme.text-muted; font-size: Theme.font-sm; vertical-alignment: center; }
                ComboBox { model: root.debug-model-options; current-value: root.debug-model-filter; min-width: 110px; selected(v) => { root.debug-model-filter = v; root.emit-filter(); } }
                Text { text: "Prompt"; color: Theme.text-muted; font-size: Theme.font-sm; vertical-alignment: center; }
                ComboBox { model: root.debug-prompt-options; current-value: root.debug-prompt-filter; min-width: 110px; selected(v) => { root.debug-prompt-filter = v; root.emit-filter(); } }
                Text { text: "Run"; color: Theme.text-muted; font-size: Theme.font-sm; vertical-alignment: center; }
                ComboBox { model: root.debug-run-options; current-value: root.debug-run-filter; min-width: 110px; selected(v) => { root.debug-run-filter = v; root.emit-filter(); } }
                Rectangle { horizontal-stretch: 1; }
            }
        }

        // Cases table — 11 columns (Python widths)
        Card {
            height: 300px;
            clip: true;
            VerticalLayout {
                padding: 4px;
                spacing: 4px;
                // Header
                Rectangle {
                    height: 26px;
                    background: Theme.header-bg;
                    border-radius: 4px;
                    HorizontalLayout {
                        padding-left: 8px;
                        spacing: 4px;
                        Text { text: "Image"; color: Theme.text-muted; font-size: Theme.font-sm; font-weight: 700; min-width: 280px; horizontal-stretch: 2.2; overflow: elide; vertical-alignment: center; }
                        Text { text: "Race Date"; color: Theme.text-muted; font-size: Theme.font-sm; font-weight: 700; min-width: 95px; vertical-alignment: center; }
                        Text { text: "File"; color: Theme.text-muted; font-size: Theme.font-sm; font-weight: 700; min-width: 85px; vertical-alignment: center; }
                        Text { text: "Process"; color: Theme.text-muted; font-size: Theme.font-sm; font-weight: 700; min-width: 85px; vertical-alignment: center; }
                        Text { text: "Best"; color: Theme.text-muted; font-size: Theme.font-sm; font-weight: 700; min-width: 100px; vertical-alignment: center; }
                        Text { text: "Latest"; color: Theme.text-muted; font-size: Theme.font-sm; font-weight: 700; min-width: 100px; vertical-alignment: center; }
                        Text { text: "Run"; color: Theme.text-muted; font-size: Theme.font-sm; font-weight: 700; min-width: 90px; overflow: elide; vertical-alignment: center; }
                        Text { text: "Model"; color: Theme.text-muted; font-size: Theme.font-sm; font-weight: 700; min-width: 85px; overflow: elide; vertical-alignment: center; }
                        Text { text: "Att"; color: Theme.text-muted; font-size: Theme.font-sm; font-weight: 700; min-width: 65px; vertical-alignment: center; }
                        Text { text: "Laps"; color: Theme.text-muted; font-size: Theme.font-sm; font-weight: 700; min-width: 55px; vertical-alignment: center; }
                        Text { text: "Rev"; color: Theme.text-muted; font-size: Theme.font-sm; font-weight: 700; min-width: 60px; vertical-alignment: center; }
                    }
                }
                dcv := ListView {
                    vertical-stretch: 1;
                    for item[index] in root.debug-cases: TouchArea {
                        height: 28px;
                        width: dcv.width;
                        clicked => { root.debug-case-selected(index); }
                        Rectangle {
                            x: 1px; y: 1px;
                            width: parent.width - 2px;
                            height: parent.height - 2px;
                            border-radius: 4px;
                            background: root.debug-selected-image-id == item.image-file-id ? Theme.selection-bg : transparent;
                            HorizontalLayout {
                                padding-left: 8px;
                                spacing: 4px;
                                Text { text: item.image-name; color: Theme.text; min-width: 280px; horizontal-stretch: 2.2; overflow: elide; vertical-alignment: center; font-size: Theme.font-sm; }
                                Text { text: item.race-date; color: Theme.text-muted; min-width: 95px; vertical-alignment: center; font-size: Theme.font-sm; overflow: elide; }
                                Text { text: item.file-status; color: Theme.text-muted; min-width: 85px; vertical-alignment: center; font-size: Theme.font-sm; }
                                Text { text: item.processing; color: item.processing == "processed_ok" ? Theme.ok : item.processing == "processed_error" ? Theme.danger : Theme.text-muted; min-width: 85px; vertical-alignment: center; font-size: Theme.font-sm; }
                                Text { text: item.best-lap; color: Theme.text-muted; min-width: 100px; vertical-alignment: center; font-size: Theme.font-sm; }
                                Text { text: item.latest-status; color: item.latest-status == "ok" ? Theme.ok : item.latest-status == "error" ? Theme.danger : Theme.text-muted; min-width: 100px; vertical-alignment: center; font-size: Theme.font-sm; }
                                Text { text: item.run-id; color: Theme.text-muted; min-width: 90px; overflow: elide; vertical-alignment: center; font-size: Theme.font-sm; }
                                Text { text: item.model; color: Theme.text-muted; min-width: 85px; overflow: elide; vertical-alignment: center; font-size: Theme.font-sm; }
                                Text { text: item.attempts; color: Theme.text-faint; min-width: 65px; vertical-alignment: center; font-size: Theme.font-sm; }
                                Text { text: item.laps; color: Theme.text-faint; min-width: 55px; vertical-alignment: center; font-size: Theme.font-sm; }
                                Text { text: item.reviews; color: Theme.text-faint; min-width: 60px; vertical-alignment: center; font-size: Theme.font-sm; }
                            }
                        }
                    }
                }
            }
            if root.debug-cases.length == 0: EmptyState {
                text: "No debug cases. Refresh to load the latest extraction cases.";
            }
        }

        // Detail header
        HorizontalLayout {
            height: 32px;
            spacing: 8px;
            Text { text: root.debug-title; color: Theme.text; font-weight: 700; horizontal-stretch: 1; overflow: elide; vertical-alignment: center; }
            ComboBox {
                min-width: 220px;
                model: root.debug-result-labels;
                current-index: 0;
                selected(value) => { root.debug-result-selected(root.debug-results[self.current-index].id); }
            }
            Button { text: "Image details"; clicked => { root.debug-open-image-detail(); } }
        }

        // Tabs — 10 tabs (Python parity)
        HorizontalLayout {
            height: 30px;
            spacing: 4px;
            for tab in [
                { key: "overview", label: "Overview" },
                { key: "metadata", label: "Metadata" },
                { key: "results", label: "Results" },
                { key: "attempts", label: "Attempts" },
                { key: "response", label: "Response" },
                { key: "parsed", label: "Parsed" },
                { key: "laps", label: "Laps & Reviews" },
                { key: "artifacts", label: "Artifacts" },
                { key: "runtime", label: "Runtime" },
                { key: "timeline", label: "Timeline" },
            ]: Rectangle {
                border-radius: 4px;
                background: root.debug-tab == tab.key ? Theme.accent : Theme.header-bg;
                min-width: 85px;
                horizontal-stretch: 1;
                TouchArea {
                    clicked => { root.debug-tab = tab.key; }
                    Text {
                        text: tab.label;
                        color: root.debug-tab == tab.key ? #ffffff : Theme.text-muted;
                        font-size: Theme.font-sm;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: parent.width;
                    }
                }
            }
        }

        Card {
            vertical-stretch: 1;
            clip: true;
            Text {
                x: 10px; y: 8px;
                width: parent.width - 20px;
                height: parent.height - 16px;
                text: root.tab-text(root.debug-tab);
                color: Theme.text-muted;
                wrap: word-wrap;
                font-size: Theme.font-sm;
            }
        }
    }
}
