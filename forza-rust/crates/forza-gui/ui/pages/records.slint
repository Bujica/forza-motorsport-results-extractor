// Records page: performance dashboard — track records, rivals, cars, progress.
// Placeholder until full implementation.

import { Card } from "../components/common.slint";
import { Theme } from "../theme.slint";

export component RecordsPage inherits Rectangle {
    background: transparent;

    in property <string> records-status;
    in property <bool> records-loading;

    callback refresh-requested();

    VerticalLayout {
        spacing: 14px;

        Text { text: "Records"; color: Theme.text; font-weight: 700; }

        Card {
            vertical-stretch: 1;
            Text {
                x: 18px; y: 14px;
                text: root.records-status;
                color: Theme.text-muted;
                font-size: Theme.font-sm;
                wrap: word-wrap;
            }
        }
    }
}
