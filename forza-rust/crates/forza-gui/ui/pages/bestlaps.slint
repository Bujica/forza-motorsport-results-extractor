// Best Laps page: cascade filters, Track·Class groups with class colours,
// and filtered exports (CSV/PDF) + import. Parity with
// forza/gui/views/best_laps_view.py + controllers/best_laps_controller.py.

import { Button, CheckBox, ComboBox, ListView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { BestLapItem } from "../models.slint";
import { Card, EmptyState, SortHeaderCell } from "../components/common.slint";

export component BestLapsPage inherits Rectangle {
    background: transparent;

    in property <[BestLapItem]> best-laps;
    in property <string> best-laps-summary;
    in property <string> best-laps-gamertag;
    in-out property <bool> best-laps-only-mine;

    // Filter option models (always include "all" at position 0).
    in property <[string]> filter-tracks: ["all"];
    in property <[string]> filter-classes: ["all"];
    in property <[string]> filter-weathers: ["all"];
    in property <[string]> filter-drivers: ["all"];
    in property <[string]> filter-cars: ["all"];
    in property <[string]> filter-sources: ["all", "screenshots", "external"];
    in property <[string]> filter-laps: ["all", "clean", "dirty"];

    // Current selections (string values).
    in-out property <string> track-filter: "all";
    in-out property <string> class-filter: "all";
    in-out property <string> weather-filter: "all";
    in-out property <string> driver-filter: "all";
    in-out property <string> car-filter: "all";
    in-out property <string> source-filter: "all";
    in-out property <string> lap-filter: "all";

    in property <int> sort-column: 0;
    in property <bool> sort-ascending: true;

    callback bestlaps-requested();
    callback rebuild-requested();
    callback filter-changed(string, string, string, string, string, string, string, bool);
    callback sort-changed(int);
    callback export-csv-requested();
    callback generate-pdf-requested();
    callback open-pdf-requested();
    callback import-requested();
    callback detail-requested(string);

    function emit-filter() {
        root.filter-changed(root.track-filter, root.class-filter, root.weather-filter,
            root.driver-filter, root.car-filter, root.lap-filter, root.source-filter, root.best-laps-only-mine);
    }

    function class-color(c: string) -> color {
        return c == "E" ? #C7368E : c == "D" ? #127F85 : c == "C" ? #BB7A00 : c == "B" ? #C54E00 : c == "A" ? #992800 : c == "TCR" ? #1E90FF : c == "S" ? #613BBF : c == "R" ? #105DAB : c == "P" ? #0C8540 : c == "X" ? #006000 : c == "Mixed" ? #555555 : #000000;
    }

    VerticalLayout {
        spacing: 14px;

        // ── Action card (banner + buttons) ──
        Card {
            height: 48px;
            HorizontalLayout {
                padding: 14px;
                spacing: 8px;
                Text { text: "Relational frontier used by PDF and CSV exports."; color: Theme.text-muted; font-size: Theme.font-sm; wrap: word-wrap; horizontal-stretch: 1; vertical-alignment: center; }
                Button { text: "Import spreadsheet"; height: 30px; clicked => { root.import-requested(); } }
                Button { text: "Generate PDF"; height: 30px; clicked => { root.generate-pdf-requested(); } }
                Button { text: "Open last PDF"; height: 30px; clicked => { root.open-pdf-requested(); } }
                Button { text: "Export CSV"; height: 30px; clicked => { root.export-csv-requested(); } }
            }
        }

        // ── Filter bar ──
        Card {
            height: 42px;
            HorizontalLayout {
                padding: 12px;
                spacing: 8px;
                Text { text: root.best-laps-gamertag == "" ? "Gamertag: not set" : "Gamertag: " + root.best-laps-gamertag; color: Theme.text-muted; font-size: Theme.font-sm; vertical-alignment: center; min-width: 160px; overflow: elide; }
                CheckBox {
                    text: "Only this driver";
                    checked <=> root.best-laps-only-mine;
                    enabled: root.best-laps-gamertag != "";
                    height: 28px;
                    toggled => { root.emit-filter(); }
                }
                Rectangle { width: 6px; }
                Text { text: "Track"; color: Theme.text-muted; font-size: Theme.font-sm; vertical-alignment: center; }
                ComboBox { model: root.filter-tracks; current-value: root.track-filter; height: 28px; min-width: 120px; selected(v) => { root.track-filter = v; root.emit-filter(); } }
                Text { text: "Class"; color: Theme.text-muted; font-size: Theme.font-sm; vertical-alignment: center; }
                ComboBox { model: root.filter-classes; current-value: root.class-filter; height: 28px; min-width: 80px; selected(v) => { root.class-filter = v; root.emit-filter(); } }
                Text { text: "Weather"; color: Theme.text-muted; font-size: Theme.font-sm; vertical-alignment: center; }
                ComboBox { model: root.filter-weathers; current-value: root.weather-filter; height: 28px; min-width: 90px; selected(v) => { root.weather-filter = v; root.emit-filter(); } }
                Text { text: "Driver"; color: Theme.text-muted; font-size: Theme.font-sm; vertical-alignment: center; }
                ComboBox { model: root.filter-drivers; current-value: root.driver-filter; height: 28px; min-width: 110px; selected(v) => { root.driver-filter = v; root.emit-filter(); } }
                Rectangle { width: 6px; }
                Text { text: "Car"; color: Theme.text-muted; font-size: Theme.font-sm; vertical-alignment: center; }
                ComboBox { model: root.filter-cars; current-value: root.car-filter; height: 28px; min-width: 130px; selected(v) => { root.car-filter = v; root.emit-filter(); } }
                Text { text: "Source"; color: Theme.text-muted; font-size: Theme.font-sm; vertical-alignment: center; }
                ComboBox { model: root.filter-sources; current-value: root.source-filter; height: 28px; min-width: 120px; selected(v) => { root.source-filter = v; root.emit-filter(); } }
                Text { text: "Lap"; color: Theme.text-muted; font-size: Theme.font-sm; vertical-alignment: center; }
                ComboBox { model: root.filter-laps; current-value: root.lap-filter; height: 28px; min-width: 90px; selected(v) => { root.lap-filter = v; root.emit-filter(); } }
                Rectangle { horizontal-stretch: 1; }
            }
        }

        // ── Table panel ──
        Card {
            clip: true;
            vertical-stretch: 1;
            VerticalLayout {
                padding: 14px;
                spacing: 14px;
                Rectangle {
                    height: 28px;
                    HorizontalLayout {
                        padding-left: 4px;
                        spacing: 8px;
                        Text { text: root.best-laps-summary; color: Theme.text-muted; font-size: Theme.font-sm; vertical-alignment: center; horizontal-stretch: 1; }
                        Button { text: "Image details"; height: 28px; clicked => { root.detail-requested(""); } }
                    }
                }
                Card {
                    clip: true;
                    vertical-stretch: 1;
                    VerticalLayout {
                        padding: 4px;
                        spacing: 4px;
                        Rectangle {
                            height: 26px;
                            background: Theme.header-bg;
                            border-radius: 4px;
                            HorizontalLayout {
                                padding-left: 8px;
                                SortHeaderCell { label: "Driver"; col-min-width: 140px; horizontal-stretch: 1.4; sort-state: root.sort-column == 0 ? (root.sort-ascending ? 1 : 2) : 0; sort-clicked => { root.sort-changed(0); } }
                                SortHeaderCell { label: "Car"; col-min-width: 150px; horizontal-stretch: 1.6; sort-state: root.sort-column == 1 ? (root.sort-ascending ? 1 : 2) : 0; sort-clicked => { root.sort-changed(1); } }
                                SortHeaderCell { label: "Best Lap"; col-min-width: 95px; horizontal-stretch: 1.1; sort-state: root.sort-column == 2 ? (root.sort-ascending ? 1 : 2) : 0; sort-clicked => { root.sort-changed(2); } }
                                SortHeaderCell { label: "Weather"; col-min-width: 75px; horizontal-stretch: 0.9; sort-state: root.sort-column == 3 ? (root.sort-ascending ? 1 : 2) : 0; sort-clicked => { root.sort-changed(3); } }
                                Text { text: "Temp"; min-width: 80px; horizontal-stretch: 0.7; vertical-alignment: center; color: Theme.text-muted; font-size: Theme.font-sm; font-weight: 700; }
                                Text { text: "Source"; horizontal-stretch: 1; vertical-alignment: center; overflow: elide; color: Theme.text-muted; font-size: Theme.font-sm; font-weight: 700; }
                            }
                        }
                        blv := ListView {
                            horizontal-stretch: 1;
                            vertical-stretch: 1;
                            for lap[index] in root.best-laps: Rectangle {
                                height: lap.is-group ? 22px : Theme.row-h;
                                horizontal-stretch: 1;
                                background: lap.is-group ? root.class-color(lap.class) : (lap.mine ? Theme.row-mine : (lap.external ? Theme.row-external : (lap.dirty ? Theme.row-dirty : (Math.mod(index, 2) == 1 ? Theme.card-alt : transparent))));
                                if lap.is-group: HorizontalLayout {
                                    padding-left: 8px;
                                    spacing: 8px;
                                    Text { text: lap.track + " · " + lap.class; color: #ffffff; font-weight: 700; font-size: Theme.font-sm; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                                    Rectangle { horizontal-stretch: 1; }
                                    Text { text: lap.group-count + " lap(s)"; color: #ffffff; font-size: Theme.font-sm; vertical-alignment: center; }
                                }
                                if !lap.is-group: HorizontalLayout {
                                    padding-left: 8px;
                                    Text { text: lap.driver; color: lap.mine ? Theme.warn : Theme.text; min-width: 140px; horizontal-stretch: 1.4; overflow: elide; vertical-alignment: center; font-size: Theme.font-sm; }
                                    Text { text: lap.car; color: Theme.text-muted; min-width: 150px; horizontal-stretch: 1.6; overflow: elide; vertical-alignment: center; font-size: Theme.font-sm; }
                                    Text { text: lap.time; color: lap.dirty ? Theme.danger : Theme.ok; min-width: 95px; horizontal-stretch: 1.1; vertical-alignment: center; font-size: Theme.font-sm; }
                                    Text { text: lap.weather; color: Theme.text-muted; min-width: 75px; horizontal-stretch: 0.9; overflow: elide; vertical-alignment: center; font-size: Theme.font-sm; }
                                    Text { text: lap.temp; color: Theme.text-muted; min-width: 80px; horizontal-stretch: 0.7; vertical-alignment: center; font-size: Theme.font-sm; }
                                    Text { text: lap.source; color: Theme.text-muted; horizontal-stretch: 1; overflow: elide; vertical-alignment: center; font-size: Theme.font-sm; }
                                }
                            }
                        }
                    }
                    if root.best-laps.length == 0: EmptyState {
                        text: "No best laps found. Run the pipeline or adjust filters.";
                    }
                }
            }
        }
    }
}
