// Images inventory page: filter bar, sortable 7-column inventory table with
// Python-style selection (plain click = single, Ctrl+click = toggle,
// Shift+click = range, Ctrl+A = all), batch action bar, and the selection
// side panel.

import { Button, ComboBox, ListView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { ImageItem } from "../models.slint";
import { Card, EmptyState, FilterCombo, BatchActionBar } from "../components/common.slint";

// Sortable column header cell; sort-state: 0 none, 1 asc, 2 desc.
component HeaderCell inherits TouchArea {
    in property <string> label;
    in property <int> column;
    in property <int> sort-state;
    in property <length> col-min-width: 60px;
    min-width: root.col-min-width;
    height: 26px;
    callback sort-clicked();
    clicked => { root.sort-clicked(); }
    HorizontalLayout {
        padding-left: 8px;
        spacing: 4px;
        Text {
            text: root.label;
            color: root.sort-state > 0 ? Theme.accent : Theme.text-muted;
            font-size: Theme.font-sm;
            font-weight: 700;
            vertical-alignment: center;
            overflow: elide;
        }
        Text {
            text: root.sort-state == 1 ? "▲" : root.sort-state == 2 ? "▼" : "";
            color: Theme.accent;
            font-size: Theme.font-xs;
            vertical-alignment: center;
        }
    }
}

export component ImagesPage inherits Rectangle {
    background: transparent;

    // Models & state (bound from MainWindow)
    in property <[ImageItem]> images;
    in property <[string]> image-tracks;
    in property <[string]> image-runs;
    in-out property <string> image-file-filter;
    in-out property <string> image-best-filter;
    in-out property <string> image-inventory-filter;
    in-out property <string> image-track-filter;
    in-out property <string> image-run-filter;
    in-out property <string> image-process-filter;
    in-out property <int> selected-index;
    in-out property <int> selected-image-count;
    in property <bool> run-running;
    in property <string> detail-title;
    in property <string> detail-lines;
    in property <image> detail-preview;
    in property <bool> detail-has-preview;
    in property <string> selection-summary;
    // Sort state: column index + direction (false asc / true desc).
    in property <int> sort-column;
    in property <bool> sort-ascending;
    in-out property <bool> confirm-delete;

    callback refresh-requested(string, string, string, string, string, string);
    callback scan-folder();
    callback selection-changed(int);
    callback selection-toggle(int);
    callback selection-single(int);
    callback selection-range(int);
    callback select-all();
    callback clear-selection();
    callback process-selected();
    callback rename-selected();
    callback export-selected();
    callback rescan-selected();
    callback delete-selected();
    callback sort-changed(int);
    callback open-image-detail(int);

    function fire-refresh() {
        root.confirm-delete = false;
        root.refresh-requested(root.image-file-filter, root.image-best-filter,
            root.image-inventory-filter, root.image-track-filter,
            root.image-run-filter, root.image-process-filter);
    }

    function header-state(column: int) -> int {
        if root.sort-column != column { return 0; }
        return root.sort-ascending ? 1 : 2;
    }

    VerticalLayout {
        spacing: 6px;

        // Filter bar
        HorizontalLayout {
            height: 32px;
            spacing: 8px;
            Text { text: "Images"; color: Theme.text; font-weight: 700; min-width: 52px; vertical-alignment: center; }
            FilterCombo { min-width: 105px; label: "File";
                model-value: ["all", "available", "missing"];
                current-index: 0; selected(value) => { root.image-file-filter = value; root.fire-refresh(); } }
            FilterCombo { min-width: 125px; label: "Best";
                model-value: ["all", "pending", "contributing", "non_contributing"];
                current-index: 0; selected(value) => { root.image-best-filter = value; root.fire-refresh(); } }
            FilterCombo { min-width: 100px; label: "Inventory";
                model-value: ["all", "duplicate"];
                current-index: 0; selected(value) => { root.image-inventory-filter = value; root.fire-refresh(); } }
            FilterCombo { min-width: 140px; horizontal-stretch: 2; label: "Track";
                model-value: root.image-tracks;
                current-index: 0; selected(value) => { root.image-track-filter = value; root.fire-refresh(); } }
            FilterCombo { min-width: 140px; horizontal-stretch: 2; label: "Run";
                model-value: root.image-runs;
                current-index: 0; selected(value) => { root.image-run-filter = value; root.fire-refresh(); } }
            FilterCombo { min-width: 120px; label: "Process";
                model-value: ["all", "unprocessed", "processing", "processed_ok",
                        "processed_error", "cancelled", "skipped"];
                current-index: 0; selected(value) => { root.image-process-filter = value; root.fire-refresh(); } }
            Button { text: "Refresh"; clicked => { root.fire-refresh(); } }
            Button { text: "Scan folder"; clicked => { root.scan-folder(); } }
            Text { text: "Selected: " + root.selected-image-count; color: Theme.text-muted; vertical-alignment: center; }
            Button { text: "Clear selection"; enabled: root.selected-image-count > 0; clicked => { root.clear-selection(); } }
        }

        HorizontalLayout {
            spacing: 8px;
            vertical-stretch: 1;

            VerticalLayout {
                horizontal-stretch: 3;
                spacing: 4px;

                // Table header
                Rectangle {
                    height: 26px;
                    background: Theme.header-bg;
                    border-radius: 4px;
                    HorizontalLayout {
                        HeaderCell { label: "Name"; column: 0; sort-state: root.header-state(0); sort-clicked() => { root.sort-changed(0); } horizontal-stretch: 3;  }
                        HeaderCell { label: "Race Date"; column: 1; sort-state: root.header-state(1); sort-clicked() => { root.sort-changed(1); } min-width: 86px;  }
                        HeaderCell { label: "Semantic"; column: 2; sort-state: root.header-state(2); sort-clicked() => { root.sort-changed(2); } horizontal-stretch: 3;  }
                        HeaderCell { label: "File"; column: 3; sort-state: root.header-state(3); sort-clicked() => { root.sort-changed(3); } min-width: 70px;  }
                        HeaderCell { label: "Duplicate"; column: 4; sort-state: root.header-state(4); sort-clicked() => { root.sort-changed(4); } min-width: 78px;  }
                        HeaderCell { label: "Process"; column: 5; sort-state: root.header-state(5); sort-clicked() => { root.sort-changed(5); } min-width: 100px;  }
                        HeaderCell { label: "Best laps"; column: 6; sort-state: root.header-state(6); sort-clicked() => { root.sort-changed(6); } min-width: 100px;  }
                    }
                }

                // Table body
                Card {
                    clip: true;
                    vertical-stretch: 1;
                    focus-scope := FocusScope {
                        width: 100%;
                        height: 100%;
                        key-pressed(event) => {
                            if event.modifiers.control && event.text == "a" {
                                root.select-all();
                                accept
                            } else {
                                reject
                            }
                        }
                        init => { self.focus(); }
                        lv := ListView {
                            x: 4px; y: 4px;
                            width: parent.width - 8px;
                            height: parent.height - 8px;
                            for item[index] in root.images: TouchArea {
                                height: Theme.row-h;
                                width: lv.width;
                                pointer-event(event) => {
                                    if event.kind == PointerEventKind.up {
                                        if event.modifiers.control {
                                            root.selected-index = index;
                                            root.selection-toggle(index);
                                        } else if event.modifiers.shift {
                                            root.selection-range(index);
                                        } else {
                                            root.selected-index = index;
                                            root.selection-single(index);
                                            root.selection-changed(index);
                                        }
                                    }
                                }
                                Rectangle {
                                    x: 1px; y: 1px;
                                    width: parent.width - 2px;
                                    height: parent.height - 2px;
                                    border-radius: 4px;
                                    background: item.selected ? Theme.row-selected
                                        : (index == root.selected-index ? Theme.selection-bg
                                        : (Math.mod(index, 2) == 1 ? Theme.card-alt : transparent));
                                    HorizontalLayout {
                                        padding-left: 8px;
                                        spacing: 4px;
                                        Text { text: item.name; color: Theme.text; horizontal-stretch: 3; min-width: 200px; overflow: elide; vertical-alignment: center; }
                                        Text { text: item.race-date; color: Theme.text-muted; min-width: 84px; vertical-alignment: center; overflow: elide; }
                                        Text { text: item.semantic; color: Theme.text-muted; horizontal-stretch: 3; min-width: 200px; overflow: elide; vertical-alignment: center; }
                                        Text { text: item.file-status; min-width: 68px; vertical-alignment: center;
                                               color: item.file-status == "available" ? Theme.ok : Theme.danger; }
                                        Text { text: item.duplicate; min-width: 74px; vertical-alignment: center;
                                               color: item.duplicate == "Canonical" ? Theme.accent : Theme.warn; }
                                        Text { text: item.processing; min-width: 96px; vertical-alignment: center;
                                               color: item.processing == "processed_ok" ? Theme.ok :
                                                      item.processing == "processed_error" ? Theme.danger :
                                                      item.processing == "processing" ? Theme.warn : Theme.text-muted; }
                                        Text { text: item.best-lap; color: Theme.text-muted; min-width: 96px; vertical-alignment: center; }
                                    }
                                }
                            }
                        }
                        if root.images.length == 0: EmptyState {
                            text: "No images match the current filters.";
                        }
                    }
                }
            }

            // Selection side panel
            VerticalLayout {
                min-width: 300px;
                max-width: 380px;
                spacing: 6px;
                Text { text: root.detail-title; color: Theme.text; font-weight: 700; }
                Card {
                    height: 190px;
                    clip: true;
                    if root.detail-has-preview: Image {
                        width: parent.width;
                        height: parent.height;
                        source: root.detail-preview;
                        image-fit: contain;
                    }
                    if !root.detail-has-preview: Text {
                        width: parent.width;
                        y: parent.height / 2 - 9px;
                        text: "preview unavailable";
                        color: Theme.text-faint;
                        horizontal-alignment: center;
                    }
                }
                Card {
                    vertical-stretch: 1;
                    Text { x: 10px; y: 8px; width: parent.width - 20px;
                           text: root.detail-lines; color: Theme.text-muted; wrap: word-wrap; font-size: Theme.font-lg; }
                }
                if root.confirm-delete: HorizontalLayout {
                    spacing: 6px;
                    Text { text: "Delete selected? Files + DB rows."; color: Theme.danger; font-size: Theme.font-xs; vertical-alignment: center; horizontal-stretch: 1; wrap: word-wrap; }
                    Button { text: "Confirm"; clicked => { root.confirm-delete = false; root.delete-selected(); } }
                    Button { text: "Cancel"; clicked => { root.confirm-delete = false; } }
                }
                Button {
                    text: "Details…";
                    enabled: root.selected-index >= 0;
                    clicked => { root.open-image-detail(root.selected-index); }
                }
                BatchActionBar {
                    selected-count: root.selected-image-count;
                    process-selected() => { root.process-selected(); }
                    rename() => { root.rename-selected(); }
                    export() => { root.export-selected(); }
                    rescan-selected() => { root.rescan-selected(); }
                    delete() => { root.confirm-delete = true; }
                }
            }
        }
    }
}
