// Images inventory page: filter bar, inventory list with multi-select, and
// the selection side panel.

import { Button, ComboBox, ListView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { ImageItem } from "../models.slint";
import { Card, EmptyState } from "../components/common.slint";

export component ImagesPage inherits Rectangle {
    background: transparent;

    // Models & state (bound from MainWindow)
    in property <[ImageItem]> images;
    in property <[string]> image-tracks;
    in property <[string]> image-runs;
    in-out property <string> image-file-filter;
    in-out property <string> image-best-filter;
    in-out property <string> image-inventory-filter;
    in-out property <string> image-track-filter;
    in-out property <string> image-run-filter;
    in-out property <string> image-process-filter;
    in-out property <int> selected-index;
    in-out property <int> selected-image-count;
    in property <bool> run-running;
    in property <string> detail-title;
    in property <string> detail-lines;
    in property <image> detail-preview;
    in property <bool> detail-has-preview;

    callback refresh-requested(string, string, string, string, string, string);
    callback selection-changed(int);
    callback selection-toggle(int);
    callback clear-selection();
    callback process-selected();
    callback rename-selected();
    callback open-image-detail(int);

    function fire-refresh() {
        root.refresh-requested(root.image-file-filter, root.image-best-filter,
            root.image-inventory-filter, root.image-track-filter,
            root.image-run-filter, root.image-process-filter);
    }

    VerticalLayout {
        spacing: 6px;

        // Filter bar
        HorizontalLayout {
            height: 32px;
            spacing: 8px;
            Text { text: "Images"; color: Theme.text; font-weight: 700; min-width: 52px; vertical-alignment: center; }
            ComboBox { min-width: 110px; model: ["all", "available", "missing"];
                current-index: 0; selected => { root.image-file-filter = self.current-value; root.fire-refresh(); } }
            ComboBox { min-width: 130px; model: ["all", "pending", "contributing", "non_contributing"];
                current-index: 0; selected => { root.image-best-filter = self.current-value; root.fire-refresh(); } }
            ComboBox { min-width: 110px; model: ["all", "duplicate"];
                current-index: 0; selected => { root.image-inventory-filter = self.current-value; root.fire-refresh(); } }
            ComboBox { min-width: 150px; horizontal-stretch: 1; model: root.image-tracks;
                current-index: 0; selected => { root.image-track-filter = self.current-value; root.fire-refresh(); } }
            ComboBox { min-width: 150px; horizontal-stretch: 1; model: root.image-runs;
                current-index: 0; selected => { root.image-run-filter = self.current-value; root.fire-refresh(); } }
            ComboBox { min-width: 130px; model: ["all", "unprocessed", "processing", "processed_ok",
                        "processed_error", "cancelled", "skipped"];
                current-index: 0; selected => { root.image-process-filter = self.current-value; root.fire-refresh(); } }
            Button { text: "Refresh"; clicked => { root.fire-refresh(); } }
            Text { text: "Selected: " + root.selected-image-count; color: Theme.text-muted; vertical-alignment: center; }
            Button { text: "Clear selection"; enabled: root.selected-image-count > 0; clicked => { root.clear-selection(); } }
        }

        HorizontalLayout {
            spacing: 8px;
            vertical-stretch: 1;

            // Inventory list
            Card {
                clip: true;
                vertical-stretch: 1;
                horizontal-stretch: 3;
                lv := ListView {
                    x: 4px; y: 4px;
                    width: parent.width - 8px;
                    height: parent.height - 8px;
                    for item[index] in root.images: TouchArea {
                        height: Theme.row-h;
                        width: lv.width;
                        clicked => {
                            root.selected-index = index;
                            root.selection-toggle(index);
                            root.selection-changed(index);
                        }
                        Rectangle {
                            x: 1px; y: 1px;
                            width: parent.width - 2px;
                            height: parent.height - 2px;
                            border-radius: 4px;
                            background: item.selected ? Theme.row-selected : (index == root.selected-index ? Theme.selection-bg : transparent);
                            HorizontalLayout {
                                padding-left: 8px;
                                Text { text: item.name; color: Theme.text; horizontal-stretch: 3; overflow: elide; vertical-alignment: center; }
                                Text { text: item.processing; min-width: 118px; vertical-alignment: center;
                                       color: item.processing == "processed_ok" ? Theme.ok :
                                              item.processing == "processed_error" ? Theme.danger :
                                              item.processing == "processing" ? Theme.warn : Theme.text-muted; }
                                Text { text: item.best-lap; color: Theme.text-muted; min-width: 112px; vertical-alignment: center; }
                            }
                        }
                    }
                }
                if root.images.length == 0: EmptyState {
                    text: "No images match the current filters.";
                }
            }

            // Selection side panel
            VerticalLayout {
                min-width: 300px;
                max-width: 380px;
                spacing: 6px;
                Text { text: root.detail-title; color: Theme.text; font-weight: 700; }
                Card {
                    height: 190px;
                    clip: true;
                    if root.detail-has-preview: Image {
                        width: parent.width;
                        height: parent.height;
                        source: root.detail-preview;
                        image-fit: contain;
                    }
                    if !root.detail-has-preview: Text {
                        width: parent.width;
                        y: parent.height / 2 - 9px;
                        text: "preview unavailable";
                        color: Theme.text-faint;
                        horizontal-alignment: center;
                    }
                }
                Card {
                    vertical-stretch: 1;
                    Text { x: 10px; y: 8px; width: parent.width - 20px;
                           text: root.detail-lines; color: Theme.text-muted; wrap: word-wrap; font-size: Theme.font-md; }
                }
                Button {
                    text: "Details…";
                    enabled: root.selected-index >= 0;
                    clicked => { root.open-image-detail(root.selected-index); }
                }
                HorizontalLayout {
                    spacing: 6px;
                    Button {
                        text: "Process selected";
                        enabled: root.selected-image-count > 0 && !root.run-running;
                        clicked => { root.process-selected(); }
                    }
                    Button {
                        text: "Rename";
                        enabled: root.selected-image-count > 0 && !root.run-running;
                        clicked => { root.rename-selected(); }
                    }
                }
            }
        }
    }
}
